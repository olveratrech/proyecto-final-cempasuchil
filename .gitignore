# Carpetas generadas por CMake, Xcode, Visual Studio o Make.
/build/
/build-*/
/cmake-build-*/
/out/
/.vs/
/.vscode/
/.idea/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
compile_commands.json
*.xcodeproj/
*.xcworkspace/
*.xcuserdata/
*.xcuserstate
*.dSYM/

# Ejecutables y archivos intermedios. El código se compila en cada plataforma.
*.exe
*.o
*.obj
*.a
*.pdb
*.ilk
*.dll
*.lib
*.exp
*.so
*.dylib

# Registros y archivos temporales de ejecución.
registro.txt
*.log
*.tmp

# En doc/ sólo se versionan los PDF finales. Se omiten las fuentes LaTeX,
# las imágenes y cualquier archivo auxiliar o temporal de compilación.
/doc/**
!/doc/
!/doc/**/
!/doc/**/*.pdf
/presentacion/*.tex

# Archivos auxiliares de LaTeX, incluso si se generan fuera de doc/.
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.lof
*.log
*.lot
*.nav
*.out
*.run.xml
*.snm
*.synctex.gz
*.toc
*.vrb

# Archivos locales del sistema y de edición.
.DS_Store
Thumbs.db
Desktop.ini
core
core.*
*~
*.swp
*.bak
*.blend1
*.blend2
__pycache__/
*.pyc
